# App
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# URLs
API_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=chat
MYSQL_PASSWORD=chat
MYSQL_DATABASE=chat_platform
MYSQL_POOL_MIN=2
MYSQL_POOL_MAX=10

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=chat:

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=900          # 15 minutes
JWT_REFRESH_TTL=2592000     # 30 days

# Widget
WIDGET_SHARED_SECRET=change-me-widget-secret-min-32-chars

# TURN
TURN_URL=turn:turn.example.com:3478
TURN_SECRET=change-me-turn-secret
TURN_TTL=3600

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
